<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>jakarta.json.bind</groupId>
        <artifactId>jakarta.json.bind-parent</artifactId>
        <version>3.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>jakarta.json.bind-api</artifactId>
    <packaging>jar</packaging>

    <name>Jakarta JSON Binding API</name>

    <properties>
        <!-- build-helper-maven-plugin configuration -->
        <legal.doc.source>${project.basedir}/..</legal.doc.source>

        <!-- glassfish-copyright-maven-plugin settings -->
        <copyright.exclude>${project.basedir}/../etc/config/copyright-exclude</copyright.exclude>
        <copyright.templatefile>${project.basedir}/../etc/config/epl-copyright.txt</copyright.templatefile>
        <copyright.bsdTemplateFile>${project.basedir}/../etc/config/edl-copyright.txt</copyright.bsdTemplateFile>
        <copyright.ignoreyear>true</copyright.ignoreyear>
        <copyright.scmonly>true</copyright.scmonly>
        <copyright.update>false</copyright.update>

        <!-- spotbugs-maven-plugin settings -->
        <spotbugs.exclude>${project.basedir}/../etc/config/spotbugs-exclude.xml</spotbugs.exclude>
    </properties>

    <dependencies>
        <dependency>
            <groupId>jakarta.json</groupId>
            <artifactId>jakarta.json-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Adds NOTICE.md and LICENSE.md from the project root into META-INF of the produced JAR. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>add-legal-resource</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>add-resource</goal>
                        </goals>
                        <configuration>
                            <resources>
                                <resource>
                                    <directory>${legal.doc.source}</directory>
                                    <includes>
                                        <include>NOTICE.md</include>
                                        <include>LICENSE.md</include>
                                    </includes>
                                    <targetPath>META-INF</targetPath>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Generates a unique build number (${buildNumber}) from SCM metadata, embedded in the OSGi manifest. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>buildnumber-maven-plugin</artifactId>
            </plugin>
            <!-- Generates the OSGi MANIFEST.MF under target/classes/META-INF during process-classes,
                 embedding bundle metadata, export packages, and spec version headers. -->
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <configuration>
                    <instructions>
                        <Build-Id>${buildNumber}</Build-Id>
                        <Bundle-Description>
                            Jakarta JSON Binding ${spec.version} API jar
                        </Bundle-Description>
                        <Bundle-Name>Jakarta JSON Binding API jar</Bundle-Name>
                        <Bundle-SymbolicName>${project.artifactId}</Bundle-SymbolicName>
                        <Bundle-Version>${project.version}</Bundle-Version>
                        <Extension-Name>${project.groupId}</Extension-Name>
                        <Implementation-Version>${project.version}</Implementation-Version>
                        <Specification-Vendor>Eclipse Foundation</Specification-Vendor>
                        <Specification-Version>${spec.version}</Specification-Version>
                        <DynamicImport-Package>*</DynamicImport-Package>                        
                        <Export-Package>
                            jakarta.json.bind.*; version=${spec.version}
                        </Export-Package>
                    </instructions>
                </configuration>
                <executions>
                    <execution>
                        <id>osgi-bundle</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>manifest</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Packages the compiled classes into a JAR, using the OSGi-generated MANIFEST.MF
                 produced by the maven-bundle-plugin. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestFile>${project.build.outputDirectory}/META-INF/MANIFEST.MF</manifestFile>
                    </archive>
                </configuration>
            </plugin>
            <!-- Generates cross-referenced HTML source reports, used as input by maven-checkstyle-plugin
                 and other reporting tools. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jxr-plugin</artifactId>
            </plugin>
            <!-- Verifies that every source file carries the required EPL-2.0 / GPL-2.0+CE copyright header. -->
            <plugin>
                <groupId>org.glassfish.copyright</groupId>
                <artifactId>glassfish-copyright-maven-plugin</artifactId>
            </plugin>
            <!-- Generates the API Javadoc with custom spec title, header, and license footer. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <configuration>
                    <doctitle>Jakarta JSON Binding ${project.version} API Specification</doctitle>
                    <header><![CDATA[<br>Jakarta JSON Binding API v${project.version}]]>
                    </header>
                    <bottom><![CDATA[
                    Comments to: <a href="mailto:${release.spec.feedback}">${release.spec.feedback}</a>.<br>
                    Copyright &#169; 2019, 2026 Eclipse Foundation. All Rights Reserved.<br>
                    Use is subject to <a href="{@docRoot}/doc-files/EFSL.html" target="_top">license terms</a>.]]>
                    </bottom>
                </configuration>
            </plugin>
            <!-- Static analysis to detect bug patterns; fails the build on High-severity findings. -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <configuration>
                    <fork>true</fork>
                    <excludeFilterFile>${spotbugs.exclude}</excludeFilterFile>
                    <failThreshold>High</failThreshold>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
